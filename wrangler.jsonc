{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fools-mate",
	"main": "./worker/index.js",
	"compatibility_date": "2026-10-01",
	"observability": {
		"enabled": true
	},
	"assets": {
		// worker/index.js serves pages through env.ASSETS.
		"binding": "ASSETS",
		// Pretty URLs like /game/abc123 and /replay/abc123 load the React app.
		"not_found_handling": "single-page-application",
		// Only the API runs the Worker. Pages, scripts and fonts are served as static
		// assets, which are free, unlimited, and keep loading even if the daily
		// Worker request limit is hit. For private mode (SITE_PASSWORD) set this to
		// true so the password also covers the pages; then every file counts as a
		// Worker request.
		"run_worker_first": ["/api/*"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "fools-mate",
			// The live database on Cloudflare (created with `wrangler d1 create`).
			// Local dev uses a separate local copy in .wrangler\ either way.
			"database_id": "622096f3-4606-48ea-84d5-ac7c1ee66787",
			"migrations_dir": "migrations"
		}
	]
}